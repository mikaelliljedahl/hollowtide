[gd_resource type="ShaderMaterial" load_steps=2 format=3]

[sub_resource type="Shader" id="Shader_neutral_ricochet"]
code = "shader_type canvas_item;\n\nvoid fragment() {\n\tvec4 source = texture(TEXTURE, UV) * COLOR;\n\tfloat value = dot(source.rgb, vec3(0.299, 0.587, 0.114));\n\tvec3 cold_neutral = vec3(value * 0.78, value * 0.86, value * 0.90);\n\tCOLOR = vec4(cold_neutral, source.a * 0.78);\n}\n"

[resource]
shader = SubResource("Shader_neutral_ricochet")
